# URL pública final do site, sem barra no final. Ex.: https://exemplo.com
VITE_SITE_URL=

# Payment Link existente da Stripe (frontend, público)
VITE_STRIPE_PAYMENT_LINK=

# --- Somente backend (Vercel → Settings → Environment Variables) ---
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcionais (valores padrão: produtos / kit-emprego-belgica-2026.pdf)
PRIVATE_PDF_BUCKET=produtos
PRIVATE_PDF_PATH=kit-emprego-belgica-2026.pdf

# --- Entrega automática após pagamento (somente backend) ---
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
